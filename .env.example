# --- GitHub webhook ---
GITHUB_WEBHOOK_SECRET=change-me

# Auth option A: GitHub App (recommended; works across repos)
GITHUB_APP_ID=
# Either paste the PEM with \n escapes, or mount the file and set the path
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# Auth option B: Personal access token (needs pull_requests:write + contents:read)
GITHUB_TOKEN=

# --- LLM (Google Gemini, free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Tried in order if the main model is overloaded or rate-limited (JSON list)
LLM_FALLBACK_MODELS=["gemini-2.5-flash","gemini-3.5-flash-lite"]
LLM_ENABLED=true

# --- Infra ---
REDIS_URL=redis://localhost:6379/0

# --- Review tuning ---
MAX_COMMENTS=25
MIN_SEVERITY=low
